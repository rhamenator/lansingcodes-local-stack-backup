+.choice { display: flex; gap: .7rem; align-items: start; line-height: 1.4; font-weight: 500; }
+.choice input { width: 1.2rem; height: 1.2rem; flex: none; margin-top: .15rem; }
+.privacy { font-size: .85rem; margin: .7rem 0; }
