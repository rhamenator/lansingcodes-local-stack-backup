diff --git a/lib/utils/simplifiedName.ts b/lib/utils/simplifiedName.ts
index 213fba8..9b1b7a1 100644
--- a/lib/utils/simplifiedName.ts
+++ b/lib/utils/simplifiedName.ts
@@ -1,4 +1,12 @@
-// Removes non-alphanumeric characters and makes it lowercase
+// Ignore harmless separators while retaining symbols that change a title's meaning.
 export function simplifiedName(name: string): string {
-  return name.toLowerCase().replace(/[^a-z0-9]/g, '')
+  return name.toLowerCase().replace(/[^a-z0-9+#]/g, '')
+}
+
+export function sameCommunityEvent(
+  first: { name: string; startTime: number },
+  second: { name: string; startTime: number },
+): boolean {
+  return first.startTime === second.startTime &&
+    simplifiedName(first.name) === simplifiedName(second.name)
 }
diff --git a/test/calendarCommunityEvent.test.mjs b/test/calendarCommunityEvent.test.mjs
new file mode 100644
index 0000000..8d0888b
--- /dev/null
+++ b/test/calendarCommunityEvent.test.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { sameCommunityEvent } from '../lib/utils/simplifiedName.ts'
+
+const at = Date.parse('2027-03-01T05:30:00Z')
+
+test('keeps different programming language titles separate at the same time', () => {
+  assert.equal(sameCommunityEvent(
+    { name: 'C++ Basics', startTime: at },
+    { name: 'C# Basics', startTime: at },
+  ), false)
+})
+
+test('still groups harmless title punctuation changes at the same time', () => {
+  assert.equal(sameCommunityEvent(
+    { name: 'Node.js Workshop', startTime: at },
+    { name: 'Nodejs Workshop', startTime: at },
+  ), true)
+  assert.equal(sameCommunityEvent(
+    { name: 'AI Workshop', startTime: at },
+    { name: 'AI-Workshop', startTime: at + 60_000 },
+  ), false)
+})
