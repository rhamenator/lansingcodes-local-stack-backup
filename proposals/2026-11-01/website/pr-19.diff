--- a/test/firebase-admin.test.mjs
+++ b/test/firebase-admin.test.mjs
@@ -6,7 +6,7 @@ import { getFirebaseAdmin, getFirestore } from '../lib/firebase/admin.ts'
 
 const names = [
   'FIREBASE_SERVICE_ACCOUNT', 'FIREBASE_PROJECT_ID',
-  'FIREBASE_CLIENT_EMAIL', 'FIREBASE_PRIVATE_KEY'
+  'FIREBASE_CLIENT_EMAIL', 'FIREBASE_PRIVATE_KEY', 'FIRESTORE_EMULATOR_HOST'
 ]
 const previous = Object.fromEntries(names.map(name => [name, process.env[name]]))
 
@@ -45,3 +45,12 @@ test('initializes Firebase Admin from service account JSON', () => {
   assert.equal(getFirebaseAdmin(), app)
   assert.equal(getFirestore().projectId, 'demo-lansingcodes')
 })
+
+test('uses the local Firestore emulator without a service account', () => {
+  for (const name of names) delete process.env[name]
+  process.env.FIREBASE_PROJECT_ID = 'demo-lansingcodes'
+  process.env.FIRESTORE_EMULATOR_HOST = '127.0.0.1:8085'
+
+  const app = getFirebaseAdmin()
+  assert.equal(app.options.projectId, 'demo-lansingcodes')
+})
diff --git a/test/meetup-sync.test.ts b/test/meetup-sync.test.ts
new file mode 100644
index 0000000..5a32c94
--- /dev/null
+++ b/test/meetup-sync.test.ts
@@ -0,0 +1,21 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { fetchEventsForGroup } from '../lib/meetup/fetchEventsForGroup'
+import { icalToEvents } from '../lib/meetup/icalToEvents'
+
+test('a failed Meetup feed aborts event replacement', async () => {
+  await assert.rejects(
+    fetchEventsForGroup('devops', { slug: 'devops' }, async () => {
+      throw new Error('Meetup unavailable')
+    }),
+    /Meetup unavailable/,
+  )
+})
+
+test('a malformed calendar aborts event replacement', () => {
+  assert.throws(() => icalToEvents('devops', 'not a calendar'), /without VCALENDAR/)
+})
+
+test('a valid empty calendar remains a valid result', () => {
