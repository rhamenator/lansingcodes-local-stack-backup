diff --git a/docs/sync-rollout.md b/docs/sync-rollout.md
index 545627e..bcd1455 100644
--- a/docs/sync-rollout.md
+++ b/docs/sync-rollout.md
@@ -5,6 +5,21 @@ collections. The sync replaces each collection from Meetup feeds or the
 repository JSON files. Use this checklist for a staging rehearsal and before
 the first production sync after a code change.
 
+## Combined sync failure results
+
+`POST /api/sync/all` waits for all three collection writers to finish. On a
+failure it returns HTTP 500 with an `outcomes` object for `events`, `groups`,
+and `sponsors`. `complete` means that writer returned successfully;
+`failed_or_partial` means it threw and may already have changed some documents.
+The route also logs the collection-specific errors and all outcomes. The
+scheduled Netlify function treats the HTTP 500 as a failed invocation.
+
+The three collection writes are not an atomic transaction. If one fails, check
+the reported outcomes and inspect all three collections before retrying. A
+successful retry can reconcile each collection from its source, but an
+interrupted writer may require manual review. Do not interpret HTTP 500 as
+proof that no Firestore documents changed.
+
 ## Admin instructions for this change
 
 1. Review and merge [website PR #18](https://github.com/lansingcodes/website/pull/18)
diff --git a/lib/sync/all.ts b/lib/sync/all.ts
new file mode 100644
index 0000000..ba142b8
--- /dev/null
+++ b/lib/sync/all.ts
@@ -0,0 +1,23 @@
+export type SyncOutcome = 'complete' | 'failed_or_partial'
+export type SyncOutcomes<Collection extends string> = Record<Collection, SyncOutcome>
+type SyncTasks<Collection extends string> = Record<Collection, () => Promise<unknown>>
+
+// Wait for every writer before reporting a combined result. A rejected writer
+// may already have changed documents, so its status must not imply rollback.
+export async function runAllSyncs<Collection extends string>(tasks: SyncTasks<Collection>) {
+  const names = Object.keys(tasks) as Collection[]
+  const settled = await Promise.allSettled(names.map((name) => tasks[name]()))
+  const outcomes = {} as SyncOutcomes<Collection>
+  const failures: Array<{ collection: Collection; error: unknown }> = []
+
+  settled.forEach((result, index) => {
+    const collection = names[index]
+    if (result.status === 'fulfilled') outcomes[collection] = 'complete'
+    else {
+      outcomes[collection] = 'failed_or_partial'
+      failures.push({ collection, error: result.reason })
+    }
+  })
+
+  return { outcomes, failures }
+}
diff --git a/test/sync-all.test.ts b/test/sync-all.test.ts
new file mode 100644
index 0000000..e05fbdf
--- /dev/null
+++ b/test/sync-all.test.ts
@@ -0,0 +1,45 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { runAllSyncs } from '../lib/sync/all'
+
+test('combined sync waits for all writers and reports every outcome', async () => {
+  let finishGroups!: () => void
+  let finished = false
+  const groups = new Promise<void>((resolve) => { finishGroups = resolve })
+  const running = runAllSyncs({
+    events: async () => { throw new Error('Meetup unavailable') },
+    groups: () => groups,
+    sponsors: async () => {},
+  }).then((result) => { finished = true; return result })
+
+  await new Promise<void>((resolve) => setImmediate(resolve))
+  assert.equal(finished, false)
+  finishGroups()
+  const result = await running
+  assert.deepEqual(result.outcomes, {
+    events: 'failed_or_partial',
+    groups: 'complete',
+    sponsors: 'complete',
+  })
+  assert.equal(result.failures.length, 1)
+  assert.equal(result.failures[0].collection, 'events')
+})
+
+test('combined sync reports success when every writer completes', async () => {
+  const result = await runAllSyncs({
+    events: async () => {}, groups: async () => {}, sponsors: async () => {},
+  })
+  assert.deepEqual(result.outcomes, {
+    events: 'complete', groups: 'complete', sponsors: 'complete',
+  })
+  assert.deepEqual(result.failures, [])
+})
+
+test('combined sync reports only event outcomes when events are the only writer', async () => {
+  const result = await runAllSyncs({
+    events: async () => { throw new Error('Meetup unavailable') },
+  })
+  assert.deepEqual(result.outcomes, { events: 'failed_or_partial' })
+  assert.equal(result.failures.length, 1)
+  assert.equal(result.failures[0].collection, 'events')
+})
