 export function parseName(name: string): string {
-  return name.replace(/\\/g, '')
+  return name.replace(/\\([\\,;nN])/g, (_, escaped: string) =>
+    escaped === 'n' || escaped === 'N' ? '\n' : escaped,
+  )
 }
diff --git a/test/parseName.test.mjs b/test/parseName.test.mjs
