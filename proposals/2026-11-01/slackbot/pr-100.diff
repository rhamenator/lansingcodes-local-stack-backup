diff --git a/dev-tools/deployment-preflight.js b/dev-tools/deployment-preflight.js
new file mode 100644
index 0000000..63c65f5
--- /dev/null
+++ b/dev-tools/deployment-preflight.js
@@ -0,0 +1,93 @@
+// Check the exact services a deployment will use without posting to Slack.
+const { createHash, randomUUID } = require('node:crypto')
+const { getApps, deleteApp } = require('firebase-admin/app')
+const { getApps: getClientApps, deleteApp: deleteClientApp } = require('firebase/app')
+const getEventsFetcher = require('../lib/fetchers/events-fetcher')
+const getEventsCacher = require('../lib/cachers/events-cacher')
+const parseJsonConfig = require('../lib/helpers/parse-json-config')
+
+function options (args) {
+  const result = { writeCheck: false }
+  for (let i = 0; i < args.length; i++) {
+    if (args[i] === '--expect-project') result.project = args[++i]
+    else if (args[i] === '--expect-team') result.team = args[++i]
+    else if (args[i] === '--write-check') result.writeCheck = true
+    else throw new Error(`Unknown option: ${args[i]}`)
+  }
+  if (!result.project) throw new Error('--expect-project is required')
+  if (!result.team) throw new Error('--expect-team is required')
+  return result
+}
+
+function checkConfiguration (expected) {
+  if (process.env.NOTIFICATION_STORE === 'memory') throw new Error('NOTIFICATION_STORE=memory cannot verify deployment persistence')
+  if (process.env.FIRESTORE_EMULATOR_HOST) throw new Error('FIRESTORE_EMULATOR_HOST cannot verify the named cloud project')
+  if (!process.env.HUBOT_SLACK_APP_TOKEN || !process.env.HUBOT_SLACK_BOT_TOKEN) throw new Error('Both Slack tokens are required')
+  if (!process.env.FIREBASE_WEB_CONFIG) throw new Error('FIREBASE_WEB_CONFIG is required')
+
+  const web = parseJsonConfig('FIREBASE_WEB_CONFIG', process.env.FIREBASE_WEB_CONFIG)
+  if (web.projectId !== expected.project) throw new Error('FIREBASE_WEB_CONFIG.projectId does not match --expect-project')
+  if (process.env.FIREBASE_PROJECT_ID && process.env.FIREBASE_PROJECT_ID !== expected.project) {
+    throw new Error('FIREBASE_PROJECT_ID does not match --expect-project')
+  }
+  if (process.env.FIREBASE_SERVICE_ACCOUNT) {
+    const serviceAccount = parseJsonConfig('FIREBASE_SERVICE_ACCOUNT', process.env.FIREBASE_SERVICE_ACCOUNT)
+    if (serviceAccount.project_id !== expected.project) throw new Error('FIREBASE_SERVICE_ACCOUNT.project_id does not match --expect-project')
+  }
+}
+
+async function checkSlack (expectedTeam) {
+  const response = await fetch('https://slack.com/api/auth.test', {
+    headers: { authorization: `Bearer ${process.env.HUBOT_SLACK_BOT_TOKEN}` },
+    signal: AbortSignal.timeout(10000)
+  })
+  if (!response.ok) throw new Error(`Slack auth.test returned HTTP ${response.status}`)
+  const result = await response.json()
+  if (!result.ok) throw new Error(`Slack auth.test failed: ${result.error}`)
+  if (result.team_id !== expectedTeam) throw new Error('Slack bot token belongs to a different workspace')
+  return result.team
+}
+
+async function checkNotificationWrite () {
+  const key = `preflight:${randomUUID()}`
+  const docId = createHash('sha256').update(key).digest('hex')
+  const cacher = getEventsCacher({})
+  const app = () => getApps().find(item => item.name === 'slackbot-notifications')
+  let doc
+  try {
+    await cacher.load()
+    const { getFirestore } = require('firebase-admin/firestore')
+    doc = getFirestore(app()).collection('slackbot_notifications').doc(docId)
+    await cacher.cache({ id: key })
+    const saved = await doc.get()
+    if (!saved.exists || saved.data().key !== key) throw new Error('Notification write/read verification failed')
+  } finally {
+    if (doc) await doc.delete()
+  }
+}
+
+async function main (args) {
+  const expected = options(args)
+  checkConfiguration(expected)
+  try {
+    const team = await checkSlack(expected.team)
+    const events = await (await getEventsFetcher({})).upcoming()
+    const cacher = await getEventsCacher({}).load()
+    if (expected.writeCheck) await checkNotificationWrite()
+    console.log(`Preflight passed: Slack workspace ${team}; Firebase project ${expected.project}; ${events.length} upcoming events; ${Object.keys(cacher.getAll()).length} notification keys; write check ${expected.writeCheck ? 'passed' : 'skipped'}.`)
+  } finally {
+    await Promise.all([
+      ...getClientApps().map(deleteClientApp),
+      ...getApps().map(deleteApp)
+    ])
+  }
+}
+
+if (require.main === module) {
+  main(process.argv.slice(2)).catch(error => {
+    console.error(`Preflight failed: ${error.message}`)
+    process.exitCode = 1
+  })
+}
+
+module.exports = { options, checkConfiguration, main }
diff --git a/dev-tools/legacy-script-smoke.js b/dev-tools/legacy-script-smoke.js
new file mode 100644
index 0000000..3094766
--- /dev/null
+++ b/dev-tools/legacy-script-smoke.js
@@ -0,0 +1,65 @@
+const { Robot, Adapter, TextMessage } = require('hubot')
+const legacyScripts = require('../legacy-scripts.json')
+const loadLegacyScripts = require('../lib/load-legacy-scripts')
+
+require('coffeescript/register')
+
+class LocalAdapter extends Adapter {
+  async send (envelope, ...strings) { this.emit('message', envelope, strings.join(' ')) }
+  async reply (envelope, ...strings) { this.emit('message', envelope, strings.join(' ')) }
+  async emote (envelope, ...strings) { this.emit('message', envelope, strings.join(' ')) }
+  async run () { this.emit('connected') }
+}
+
+async function expectMessage (robot, command, pattern) {
+  const response = new Promise((resolve, reject) => {
+    const onMessage = (_envelope, text) => {
+      if (!pattern.test(text)) return
+      clearTimeout(timer)
+      robot.adapter.off('message', onMessage)
+      resolve(text)
+    }
+    const timer = setTimeout(() => {
+      robot.adapter.off('message', onMessage)
+      reject(new Error(`Timed out after: ${command}`))
+    }, 5000)
+    robot.adapter.on('message', onMessage)
+  })
+  const user = robot.brain.userForId('ULOCAL', { name: 'local', room: 'CLOCAL' })
+  await robot.adapter.receive(new TextMessage(user, command))
+  await response
+  console.log(`PASS: ${command}`)
+}
+
+async function main () {
+  process.env.HUBOT_HEROKU_KEEPALIVE_URL = 'https://example.test/'
+  process.env.HUBOT_HEROKU_KEEPALIVE_INTERVAL = '0'
+  const robot = new Robot('local-adapter', false, 'slackbot')
+  robot.adapter = new LocalAdapter(robot)
+  robot.setupNullRouter()
+  await loadLegacyScripts(robot, legacyScripts)
+  require('../lib/initializers/heroku-keepalive')(robot)
+  require('../lib/initializers/legacy-video-rooms')(robot)
+  require('../lib/initializers/legacy-maps')(robot)
+  require('../lib/initializers/legacy-shipit')(robot)
+  await robot.run()
+  try {
+    await expectMessage(robot, 'slackbot ping', /PONG/i)
+    await expectMessage(robot, 'slackbot echo local check', /local check/)
+    await expectMessage(robot, 'slackbot the rules', /A robot (may not|must)/i)
+    await expectMessage(robot, 'slackbot thank you', /welcome|problem|pleasure|sure|bother|all right|nothing|not at all|mention it/i)
+    await expectMessage(robot, 'slackbot principle me', /./)
+    await expectMessage(robot, 'What is bikeshedding?', /Parkinson.*Law of Triviality/i)
+    await expectMessage(robot, 'slackbot appearin integration-check', /^https:\/\/meet\.jit\.si\/integration-check$/)
+    await expectMessage(robot, 'slackbot map me Lansing, MI', /^https:\/\/www\.google\.com\/maps\/search\//)
+    await expectMessage(robot, 'ship it', /^https:\/\/.*\.(?:png|jpg)$/)
+    await expectMessage(robot, 'slackbot shoot local in the body', /foam dart|Target acquired|shoot/i)
+  } finally {
+    robot.shutdown()
+  }
+}
+
+main().catch(error => {
+  console.error(error)
+  process.exitCode = 1
+})
diff --git a/dev-tools/live-event-channel-smoke.js b/dev-tools/live-event-channel-smoke.js
new file mode 100644
index 0000000..a089c03
--- /dev/null
+++ b/dev-tools/live-event-channel-smoke.js
@@ -0,0 +1,110 @@
+// Opt-in service check: stage one event, run the real scheduler twice, and
+// confirm it announces only once in the configured test Slack channel.
+const assert = require('node:assert/strict')
+const { createHash, randomUUID } = require('node:crypto')
+const { initializeApp, getApps, deleteApp, cert } = require('firebase-admin/app')
+const { getFirestore } = require('firebase-admin/firestore')
+const { getApps: getClientApps, deleteApp: deleteClientApp } = require('firebase/app')
+const { getFirestore: getClientFirestore, terminate } = require('firebase/firestore')
+
+const projectId = 'lansing-codes-test-staging'
+const teamId = 'T0CCAQ20G0P'
+
+async function slackApi (method, body) {
+  const inspect = method === 'conversations.info'
+  const url = new URL(`https://slack.com/api/${method}`)
+  if (inspect) url.searchParams.set('channel', body.channel)
+  const response = await fetch(url, {
+    method: inspect ? 'GET' : 'POST',
+    headers: {
+      authorization: `Bearer ${process.env.HUBOT_SLACK_BOT_TOKEN}`,
+      'content-type': 'application/json; charset=utf-8'
+    },
+    body: inspect ? undefined : JSON.stringify(body || {}),
+    signal: AbortSignal.timeout(15000)
+  })
+  if (!response.ok) throw new Error(`Slack ${method} returned HTTP ${response.status}`)
+  return response.json()
+}
+
+async function main () {
+  assert.equal(process.env.FIRESTORE_EMULATOR_HOST, undefined, 'Use cloud Firestore')
+  assert.notEqual(process.env.NOTIFICATION_STORE, 'memory', 'Use persistent notifications')
+  const webConfig = JSON.parse(process.env.FIREBASE_WEB_CONFIG || '{}')
+  const serviceAccount = JSON.parse(process.env.FIREBASE_SERVICE_ACCOUNT || '{}')
+  assert.equal(webConfig.projectId, projectId, 'Wrong Firebase web project')
+  assert.equal(serviceAccount.project_id, projectId, 'Wrong Firebase Admin project')
+  assert(process.env.HUBOT_SLACK_BOT_TOKEN?.startsWith('xoxb-'), 'Missing test bot token')
+  const channel = process.env.EVENT_ANNOUNCEMENT_CHANNEL_ID
+  assert(channel?.startsWith('C'), 'Set the test announcement channel ID')
+  const auth = await slackApi('auth.test')
+  assert.equal(auth.team_id, teamId, 'Wrong Slack workspace')
+  const info = await slackApi('conversations.info', { channel })
+  assert.equal(info.ok, true, `Cannot inspect test channel: ${info.error || 'unknown error'}`)
+  assert(['upcoming-events', 'events'].includes(info.channel?.name), 'Use a dedicated test events channel')
+
+  const id = `live-channel-smoke-${randomUUID()}`
+  const url = `https://example.org/lansing-codes-channel-test/${id}`
+  const event = {
+    name: `Lansing Codes test: event channel routing (${id})`,
+    url,
+    group: 'channel-smoke',
+    startTime: Date.now() + 3 * 24 * 60 * 60 * 1000
+  }
+  const app = initializeApp({ projectId, credential: cert(serviceAccount) }, 'channel-smoke')
+  const db = getFirestore(app)
+  const eventRef = db.collection('events').doc(id)
+  const notificationRef = db.collection('slackbot_notifications')
+    .doc(createHash('sha256').update(id).digest('hex'))
+  const posted = []
+  const errors = []
+  const robot = {
+    adapter: {
+      client: {
+        web: {
+          chat: {
+            postMessage: async body => {
+              const result = await slackApi('chat.postMessage', body)
+              posted.push({ channel: body.channel, text: body.text, ts: result.ts })
+              return result
+            }
+          }
+        }
+      }
+    },
+    logger: { error: message => errors.push(message), warn: message => errors.push(message) }
+  }
+
+  try {
+    await eventRef.create(event)
+    const run = require('../lib/scheduled-tasks/check-for-upcoming-events')
+    await run(robot)
+    await run(robot)
+    assert.deepEqual(errors, [], 'Scheduler reported an error')
+    const eventPosts = posted.filter(message => message.text.includes(url))
+    assert.equal(eventPosts.length, 1, 'Event must be announced exactly once')
+    assert.equal(eventPosts[0].channel, channel, 'Event must use the dedicated channel')
+    const morningPosts = posted.filter(message => message.text.startsWith('Good morning everyone!'))
+    const noNewEventsPosts = posted.filter(message => message.text.startsWith("I didn't find any new meetups."))
+    assert.equal(morningPosts.length, 2, 'Each scheduler run must post one morning message')
+    assert.equal(noNewEventsPosts.length, 1, 'The second run must report no new events')
+    assert(posted.every(message => message.channel === channel),
+      'Every scheduler message must use the dedicated channel')
+    const claim = await notificationRef.get()
+    assert.equal(claim.get('status'), 'delivered')
+    assert.equal(claim.get('key'), id)
+    console.log(`PASS: scheduler messages stayed in #${info.channel.name}; event announced once at ${eventPosts[0].ts} and did not repeat`)
+  } finally {
+    await Promise.all([eventRef.delete(), notificationRef.delete()])
+    await Promise.all(getClientApps().map(async app => {
+      await terminate(getClientFirestore(app))
+      await deleteClientApp(app)
+    }))
+    await Promise.all(getApps().map(deleteApp))
+  }
+}
+
+main().catch(error => {
+  console.error(`Live event channel smoke failed: ${error.message}`)
+  process.exitCode = 1
+})
