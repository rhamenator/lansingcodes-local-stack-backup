diff --git a/lib/helpers/format-time.js b/lib/helpers/format-time.js
index 8f0d55e..0fd394f 100644
--- a/lib/helpers/format-time.js
+++ b/lib/helpers/format-time.js
@@ -1,3 +1,21 @@
-const moment = require('moment')
+const formatter = new Intl.DateTimeFormat('en-US', {
+  timeZone: 'America/Detroit',
+  weekday: 'long',
+  month: 'long',
+  day: 'numeric',
+  hour: 'numeric',
+  minute: '2-digit',
+  hour12: true
+})
 
-module.exports = time => moment(time).format('dddd, MMMM Do [at] h:mma')
+const ordinal = day => {
+  if (day % 100 >= 11 && day % 100 <= 13) return `${day}th`
+  return `${day}${{ 1: 'st', 2: 'nd', 3: 'rd' }[day % 10] || 'th'}`
+}
+
+module.exports = time => {
+  const date = new Date(time)
+  if (Number.isNaN(date.valueOf())) return 'Invalid date'
+  const parts = Object.fromEntries(formatter.formatToParts(date).map(part => [part.type, part.value]))
+  return `${parts.weekday}, ${parts.month} ${ordinal(Number(parts.day))} at ${parts.hour}:${parts.minute}${parts.dayPeriod.toLowerCase()}`
+}
