diff --git a/lib/initializers/new-member-greeter.js b/lib/initializers/new-member-greeter.js
new file mode 100644
index 0000000..fa0f01f
--- /dev/null
+++ b/lib/initializers/new-member-greeter.js
@@ -0,0 +1,48 @@
+// Description:
+//   Greet a person once when they join the workspace's welcome channel.
+//
+// Configuration:
+//   MEMBER_GREETING_CHANNEL_ID - Slack channel ID; defaults to #general.
+//
+// Notes:
+//   Uses the persistent notification store so a restart or another channel
+//   join does not send the same person another greeting.
+
+const getEventsCacher = require('../cachers/events-cacher')
+const postRoomMessage = require('../helpers/post-room-message')
+
+module.exports = (robot) => {
+  const notifications = getEventsCacher(robot)
+
+  robot.enter(async (message) => {
+    const user = message.envelope.user
+    const roomId = user?.room
+    if (!user?.id || !roomId || user.is_bot || user.bot_id ||
+        user.id === robot.adapter?.self?.user_id) return
+
+    const configuredRoom = process.env.MEMBER_GREETING_CHANNEL_ID
+    if (configuredRoom) {
+      if (roomId !== configuredRoom) return
+    } else {
+      let room = roomId
+      try {
+        room = (await robot.adapter.client?.fetchConversation(roomId))?.name || roomId
+      } catch (error) {
+        robot.logger.warn(`Could not look up greeting channel ${roomId}: ${error.message}`)
+      }
+      if (room !== 'general') return
+    }
+
+    const teamId = robot.adapter?.self?.team_id || 'workspace'
+    const notification = { id: `member-greeting:${teamId}:${user.id}` }
+    const greeting = `<@${user.id}> welcome to Lansing Codes! :wave: Please read our ` +
+      '<https://www.lansing.codes/code-of-conduct|Code of Conduct>. ' +
+      'Ask me for `upcoming events` whenever you want to see what is happening.'
+
+    try {
+      await notifications.deliverOnce(notification, () => postRoomMessage(robot, roomId, greeting))
+    } catch (error) {
+      robot.logger.error(`Could not greet new member ${user.id}: ${error.message}`)
+    }
+  })
+}
diff --git a/spec/lib/initializers/new-member-greeter-spec.js b/spec/lib/initializers/new-member-greeter-spec.js
new file mode 100644
index 0000000..7c9ae4c
--- /dev/null
+++ b/spec/lib/initializers/new-member-greeter-spec.js
@@ -0,0 +1,61 @@
+const includeHubot = require('../../helpers/include-hubot')
+
+describe('new-member-greeter', () => {
+  includeHubot()
+
+  beforeEach(() => {
+    process.env.NOTIFICATION_STORE = 'memory'
+    require('../../../lib/initializers/new-member-greeter')(robot)
+  })
+
+  afterEach(() => {
+    delete process.env.MEMBER_GREETING_CHANNEL_ID
+    delete process.env.NOTIFICATION_STORE
+  })
+
+  it('greets a new member in general and does not repeat the greeting', async () => {
+    const sent = jasmine.createSpy('sent')
+    robot.adapter.on('send', sent)
+    const newcomer = robot.brain.userForId('UNEW', { name: 'newcomer', room: 'general' })
+
+    await hubotHelpers.receiveEntrance(newcomer)
+    await hubotHelpers.receiveEntrance(newcomer)
+
+    expect(sent.calls.count()).toBe(1)
+    expect(sent.calls.first().args[0].room).toBe('general')
+    expect(sent.calls.first().args[1][0]).toContain('<@UNEW> welcome to Lansing Codes!')
+    expect(sent.calls.first().args[1][0]).toContain('/code-of-conduct')
+    expect(sent.calls.first().args[1][0]).toContain('`upcoming events`')
+  })
+
+  it('uses the configured channel ID and ignores other channels and the bot itself', async () => {
+    process.env.MEMBER_GREETING_CHANNEL_ID = 'CWELCOME'
+    robot.adapter.self = { user_id: 'UBOT', team_id: 'TTEST' }
+    const sent = jasmine.createSpy('sent')
+    robot.adapter.on('send', sent)
+
+    await hubotHelpers.receiveEntrance(robot.brain.userForId('UOTHER', { room: 'COTHER' }))
+    await hubotHelpers.receiveEntrance(robot.brain.userForId('UBOT', { room: 'CWELCOME' }))
+    await hubotHelpers.receiveEntrance(robot.brain.userForId('UNEW', { room: 'CWELCOME' }))
+
+    expect(sent.calls.count()).toBe(1)
+    expect(sent.calls.first().args[0].room).toBe('CWELCOME')
+  })
+
+  it('does not record a greeting when Slack rejects the post', async () => {
+    process.env.MEMBER_GREETING_CHANNEL_ID = 'CWELCOME'
+    robot.adapter.client = { web: { chat: { postMessage: jasmine.createSpy('postMessage') } } }
+    robot.adapter.client.web.chat.postMessage.and.returnValues(
+      Promise.resolve({ ok: false, error: 'not_in_channel' }),
+      Promise.resolve({ ok: true })
+    )
+    spyOn(robot.logger, 'error')
+    const newcomer = robot.brain.userForId('UNEW', { room: 'CWELCOME' })
+
+    await hubotHelpers.receiveEntrance(newcomer)
+    await hubotHelpers.receiveEntrance(newcomer)
+
+    expect(robot.adapter.client.web.chat.postMessage.calls.count()).toBe(2)
+    expect(robot.logger.error).toHaveBeenCalled()
+  })
+})
