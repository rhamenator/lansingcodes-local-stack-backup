diff --git a/render.js b/render.js
new file mode 100644
index 0000000..e132fcc
--- /dev/null
+++ b/render.js
@@ -0,0 +1,23 @@
+export function appendEvent(list, event, when, doc = document) {
+  const li = doc.createElement('li')
+  const time = doc.createElement('code')
+  time.textContent = when
+  li.append(time, ' - ')
+
+  let url
+  try {
+    url = new URL(event.url)
+  } catch {
+    // Keep the event name visible even if the stored URL is invalid.
+  }
+
+  if (url && ['http:', 'https:'].includes(url.protocol)) {
+    const link = doc.createElement('a')
+    link.href = url.href
+    link.textContent = event.name || 'Unnamed event'
+    li.append(link)
+  } else {
+    li.append(doc.createTextNode(event.name || 'Unnamed event'))
+  }
+  list.append(li)
+}
diff --git a/test/events.test.js b/test/events.test.js
new file mode 100644
index 0000000..09984fc
--- /dev/null
+++ b/test/events.test.js
@@ -0,0 +1,39 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { JSDOM } from 'jsdom'
+import { eventQuery, fetchEvents } from '../events.js'
+import { appendEvent } from '../render.js'
+
+test('queries the event range in start-time order', () => {
+  const query = eventQuery(10, 20).structuredQuery
+  assert.equal(query.from[0].collectionId, 'events')
+  assert.deepEqual(query.where.compositeFilter.filters.map((filter) => filter.fieldFilter.value.integerValue), ['10', '20'])
+  assert.equal(query.orderBy[0].field.fieldPath, 'startTime')
+})
+
+test('reads event fields from Firestore REST rows without an API key', async () => {
+  const events = await fetchEvents(10, 20, async (url, options) => {
+    assert.equal(url, 'https://firestore.googleapis.com/v1/projects/lansing-codes/databases/(default)/documents:runQuery')
+    assert.equal(options.method, 'POST')
+    return {
+      ok: true,
+      json: async () => [{ document: { fields: {
+        name: { stringValue: 'Meetup' },
+        url: { stringValue: 'https://example.org/event' },
+        startTime: { integerValue: '15' },
+      } } }],
+    }
+  })
+  assert.deepEqual(events, [{ name: 'Meetup', url: 'https://example.org/event', startTime: 15 }])
+})
+
+test('renders names as text and rejects unsafe links', () => {
+  const doc = new JSDOM('<ul></ul>').window.document
+  const list = doc.querySelector('ul')
+  appendEvent(list, { name: '<img src=x onerror=alert(1)>', url: 'javascript:alert(1)' }, '7pm', doc)
+  assert.equal(list.querySelector('img'), null)
+  assert.equal(list.querySelector('a'), null)
+  assert.match(list.textContent, /<img src=x onerror=alert\(1\)>/)
+  appendEvent(list, { name: 'Safe', url: 'https://example.org' }, '8pm', doc)
+  assert.equal(list.querySelector('a').href, 'https://example.org/')
+})
diff --git a/test/refresh.test.js b/test/refresh.test.js
new file mode 100644
index 0000000..b796ce8
--- /dev/null
+++ b/test/refresh.test.js
@@ -0,0 +1,54 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { JSDOM } from 'jsdom'
+import moment from 'moment-timezone'
+
+test('older event loads cannot append stale dates or errors after a refresh', async () => {
+  const html = readFileSync(new URL('../index.html', import.meta.url), 'utf8')
+  const dom = new JSDOM(html, { url: 'http://localhost/' })
+  const previous = { window: globalThis.window, document: globalThis.document, fetch: globalThis.fetch }
+  const pending = []
+
+  try {
+    globalThis.window = dom.window
+    globalThis.document = dom.window.document
+    window.moment = moment
+    globalThis.fetch = () => new Promise((resolve, reject) => pending.push({ resolve, reject }))
+
+    await import(`../index.js?refresh-test=${Date.now()}`)
+    assert.equal(pending.length, 2)
+
+    document.getElementById('date-format').value = '[NEW] h:mm a'
+    document.getElementById('refresh-format').click()
+    assert.equal(pending.length, 4)
+
+    const row = { document: { fields: {
+      name: { stringValue: 'Race test' },
+      url: { stringValue: 'https://example.org/event' },
+      startTime: { integerValue: String(moment().valueOf()) },
+    } } }
+    const response = () => ({ ok: true, json: async () => [row] })
+
+    pending[2].resolve(response())
+    pending[3].resolve(response())
+    await new Promise((resolve) => setImmediate(resolve))
+
+    // The startup loads finish late: one succeeds and one fails.
+    pending[0].reject(new Error('stale request failed'))
+    pending[1].resolve(response())
+    await new Promise((resolve) => setImmediate(resolve))
+
+    for (const id of ['next-month-event-list', 'current-month-event-list']) {
+      const list = document.getElementById(id)
+      assert.equal(list.children.length, 1)
+      assert.match(list.textContent, /^NEW .*Race test$/)
+      assert.doesNotMatch(list.textContent, /could not be loaded/)
+    }
+  } finally {
+    globalThis.window = previous.window
+    globalThis.document = previous.document
+    globalThis.fetch = previous.fetch
+    dom.window.close()
+  }
+})
diff --git a/test/timezone.test.js b/test/timezone.test.js
new file mode 100644
index 0000000..98137e5
--- /dev/null
+++ b/test/timezone.test.js
@@ -0,0 +1,61 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { JSDOM } from 'jsdom'
+
+test('Lansing month query and displayed times are stable outside Eastern time', async () => {
+  const previous = {
+    window: globalThis.window,
+    document: globalThis.document,
+    fetch: globalThis.fetch,
+    timezone: process.env.TZ,
+  }
+  const html = readFileSync(new URL('../index.html', import.meta.url), 'utf8')
+  const dom = new JSDOM(html, { url: 'http://localhost/', runScripts: 'outside-only' })
+  const queries = []
+
+  try {
+    process.env.TZ = 'America/Los_Angeles'
+    for (const name of ['moment.min.js', 'moment-timezone.min.js', 'moment-timezone-detroit.js']) {
+      dom.window.eval(readFileSync(new URL(`../vendor/${name}`, import.meta.url), 'utf8'))
+    }
+    dom.window.moment.now = () => Date.parse('2027-03-01T05:30:00Z')
+    globalThis.window = dom.window
+    globalThis.document = dom.window.document
+    globalThis.fetch = async (_url, options) => {
+      const filters = JSON.parse(options.body).structuredQuery.where.compositeFilter.filters
+      const [start, end] = filters.map(({ fieldFilter }) => Number(fieldFilter.value.integerValue))
+      queries.push([start, end])
+      const event = (name, instant) => ({ document: { fields: {
+        name: { stringValue: name },
+        url: { stringValue: 'https://example.org/event' },
+        startTime: { integerValue: String(Date.parse(instant)) },
+      } } })
+      return {
+        ok: true,
+        json: async () => start === Date.parse('2027-03-01T05:00:00Z')
+          ? [event('Month boundary', '2027-03-01T05:30:00Z'), event('DST change', '2027-03-14T07:30:00Z')]
+          : [],
+      }
+    }
+
+    await import(`../index.js?timezone-test=${Math.random()}`)
+    await new Promise(resolve => setImmediate(resolve))
+
+    assert.equal(document.getElementById('current-month-name').textContent, 'March')
+    assert.equal(document.getElementById('next-month-name').textContent, 'April')
+    assert(queries.some(([start, end]) =>
+      start === Date.parse('2027-03-01T05:00:00Z') && end === Date.parse('2027-04-01T03:59:59.999Z')))
+    assert(queries.some(([start]) => start === Date.parse('2027-04-01T04:00:00Z')))
+    const list = document.getElementById('current-month-event-list').textContent
+    assert.match(list, /1st \(Mon\) 12:30 am.*Month boundary/)
+    assert.match(list, /14th \(Sun\) 3:30 am.*DST change/)
+  } finally {
+    globalThis.window = previous.window
+    globalThis.document = previous.document
+    globalThis.fetch = previous.fetch
+    if (previous.timezone === undefined) delete process.env.TZ
+    else process.env.TZ = previous.timezone
+    dom.window.close()
+  }
+})
