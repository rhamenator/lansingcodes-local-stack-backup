rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The website and Slackbot display these collections to the public.
    match /events/{document} {
      allow read: if true;
    }
    match /groups/{document} {
      allow read: if true;
    }
    match /sponsors/{document} {
      allow read: if true;
    }
    // Sync writes use the Admin SDK; clients may not write or read other data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
